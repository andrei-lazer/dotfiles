[user]
	email = andrei.lazer319@gmail.com
	name = andrei-lazer
[alias]
    st = status --short
    lg = log -1
    adog = log --all --decorate --oneline --graph
[init]
	defaultBranch = main
[core]
    compression = 9
    whitespace = error
	editor = nvim
[status]
    branch = true
    showStas = true
    showUntrackedFiles = true
[push]
    autoSetupRemote = true
    default = current
